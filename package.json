{
  "name": "@effiz/datepicker",
  "version": "0.1.0",
  "description": "A Flowbite-style, themeable datepicker component for Vue 3 with date, month, year and range selection.",
  "type": "module",
  "license": "MIT",
  "author": "La French Audit",
  "keywords": [
    "vue",
    "vue3",
    "datepicker",
    "date-picker",
    "calendar",
    "tailwind",
    "flowbite",
    "date-range",
    "month-picker",
    "year-picker"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/effiz-datepicker.umd.cjs",
  "module": "./dist/effiz-datepicker.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/effiz-datepicker.js",
      "require": "./dist/effiz-datepicker.umd.cjs"
    },
    "./style.css": "./dist/effiz-datepicker.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --force && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
